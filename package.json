{
  "name": "student-pixel",
  "version": "0.15.2-SNAPSHOT",
  "description": "Pixel art editor",
  "author": "Julian Descottes <julian.descottes@gmail.com>",
  "contributors": [
    "Vincent Renaudin"
  ],
  "homepage": "https://ragingaxolotl-art.github.io/Student_pixel/",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ragingaxolotl-art/Student_pixel.git"
  },
  "files": [
    "dest/prod",
    "misc/scripts/piskel-root"
  ],
  "main": "./dest/prod/index.html",
  "scripts": {
    "prepare": "husky",
    "build": "npm run build:sprites && vite build && node scripts/partials.js",
    "build:sprites": "node scripts/sprite.js",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "unit-tests": "karma start",
    "unit-tests:watch": "karma start --auto-watch --no-single-run",
    "preview:pages": "node scripts/serve-pages.cjs",
    "test:pages": "playwright test -c playwright.pages.config.ts",
    "test": "npm run unit-tests && npm run test:pages"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.10",
    "@playwright/test": "1.61.1",
    "@types/adm-zip": "0.5.8",
    "adm-zip": "0.5.17",
    "dateformat": "4.5.1",
    "fs-extra": "10.0.0",
    "gifuct-js": "2.1.2",
    "husky": "9.1.7",
    "jasmine-core": "3.8.0",
    "karma": "6.3.4",
    "karma-chrome-launcher": "3.2.0",
    "karma-jasmine": "4.0.1",
    "magic-string": "0.30.21",
    "nw-builder": "4.17.5",
    "png-ts": "0.0.3",
    "puppeteer": "24.40.0",
    "rmdir": "1.2.0",
    "spritesheet-templates": "10.5.2",
    "spritesmith": "3.5.1",
    "terser": "5.46.1",
    "typescript": "5.9.3",
    "vite": "8.0.7"
  },
  "dependencies": {
    "minimist": "1.2.8"
  },
  "private": true
}
